# Discord IDをカンマ区切りで指定。このユーザーだけ管理者チャットへ投稿できます。
CHAT_ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# 管理者チャットの転送先Botとチャンネル。
CHAT_DISCORD_BOT_TOKEN=
CHAT_DISCORD_CHANNEL_ID=

# 匿名ID用。未設定なら既存のIDENTITY_HASH_KEYまたはFLASK_SECRET_KEYを使用します。
CHAT_IDENTITY_HASH_KEY=

# Web Push用。CHAT/generate_vapid_keys.pyで生成できます。
CHAT_VAPID_PUBLIC_KEY=
CHAT_VAPID_PRIVATE_KEY=
CHAT_VAPID_SUBJECT=mailto:admin@autocat.jp

